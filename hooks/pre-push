#!/bin/sh
# The real gate: the same two commands CI runs, before the push that would have run them
# there -- `ruff check .` then the full suite.
#
# The suite is not green today, and pretending otherwise would make this hook cry wolf on
# its first run -- after which everyone reaches for --no-verify and it protects nothing.
# So a failure only blocks if it is NOT in hooks/known-failures.txt. That file is a debt
# list: it should only ever shrink, and the hook tells you when an entry starts passing so
# you can delete it.
#
# Escape hatch: git push --no-verify, or USD_CHUNKS_SKIP_PREPUSH=1.
. "$(git rev-parse --show-toplevel)/hooks/_common.sh"
run_local_hook pre-push "$@"

[ -n "$USD_CHUNKS_SKIP_PREPUSH" ] && exit 0

root="$(git rev-parse --show-toplevel)"
baseline="$root/hooks/known-failures.txt"
out="$(mktemp)"
got="$(mktemp)"
want="$(mktemp)"
trap 'rm -f "$out" "$got" "$want"' EXIT

if command -v ruff > /dev/null 2>&1; then
    # TRACKED files only, which is what CI lints -- it checks out the repository, so an
    # untracked file in your working tree is invisible to it. Linting the tree instead
    # (plain `ruff check .`) means a scratch script you never intend to commit blocks every
    # push: measured at 129 errors from working-tree-only files in one real checkout, none
    # of which CI would ever see.
    say "pre-push: ruff (tracked Python)"
    if ! git ls-files -z '*.py' | xargs -0 ruff check --; then
        say "pre-push: ruff failed. Fix, or push with --no-verify."
        exit 1
    fi
fi

say "pre-push: pytest (full suite, a few minutes -- Ctrl-C, or push with --no-verify, to skip)"
# --color=no matters: pytest colours its output even when it is redirected to a file (it
# does so here), and the escape codes sit in front of the word FAILED, so the summary parse
# below silently matched nothing and every run looked green.
python -m pytest "$root/tests" -q -rf --color=no > "$out" 2>&1
status=$?

# pytest exit codes: 0 all passed, 1 tests failed. Anything else -- a collection error, an
# interrupt, an internal error -- is not a result this hook can reason about, so show it
# rather than quietly deciding the baseline covers it.
if [ "$status" -ne 0 ] && [ "$status" -ne 1 ]; then
    tail -30 "$out" >&2
    say "pre-push: pytest exited $status (not a test failure). Blocking."
    exit 1
fi

grep '^FAILED ' "$out" | sed 's/
$//; s/^FAILED //; s/ - .*//' | sort -u > "$got"

# pytest said something failed but nothing could be read out of its summary: the parse is
# broken, not the suite. Block -- a gate that cannot see failures must not report success.
if [ "$status" -eq 1 ] && [ ! -s "$got" ]; then
    tail -30 "$out" >&2
    say "pre-push: pytest reported failures, but none could be parsed from its output."
    say "pre-push: refusing to call that a pass. Push with --no-verify if you must."
    exit 1
fi
# Two lists, both optional. known-failures.txt is shared and is about the code -- what
# fails on main for everyone. known-failures.local.txt is yours, gitignored, and is for
# what only fails on YOUR machine: a scratch chunk in scripts/ that trips test_chunk_deps,
# a pip test that needs a network you do not have. Keeping those out of the shared list
# matters in both directions -- they would mask a real regression for everyone else, and
# the "this passed, delete it" report would nag whoever does not share your environment.
: > "$want"
for f in "$baseline" "$root/hooks/known-failures.local.txt"; do
    [ -f "$f" ] || continue
    grep -v '^[[:space:]]*#' "$f" | sed '/^[[:space:]]*$/d' >> "$want"
done
sort -u -o "$want" "$want"

new=$(comm -23 "$got" "$want")
fixed=$(comm -13 "$got" "$want")

if [ -n "$fixed" ]; then
    say ""
    say "pre-push: these are in hooks/known-failures.txt but PASSED -- please delete them from it:"
    printf '  %s\n' $fixed >&2
fi

if [ -n "$new" ]; then
    say ""
    say "pre-push: failures that are not in hooks/known-failures.txt:"
    printf '  %s\n' $new >&2
    say ""
    say "Fix them, or push with --no-verify if you know better."
    exit 1
fi

say "pre-push: ok (known failures only)"
