#!/bin/sh
# Fast gate: lint everything staged, plus a few seconds of tests.
#
# A commit hook is only useful if it never makes you think twice about committing, so the
# full suite is deliberately NOT here -- it runs on pre-push, right before the code would
# have reached CI. What runs here is what a broken commit almost always trips:
#
#   * ruff over the staged Python, which is literally CI's first step
#   * a core smoke set (~4s): the framework basics, and test_new_chunks, which loads every
#     chunk in scripts/ and so catches a chunk that no longer imports or builds
#   * any test file the commit itself touches -- a new test is exactly the one most likely
#     to be wrong, and you already believe it is worth running
#
# Escape hatch: git commit --no-verify.
. "$(git rev-parse --show-toplevel)/hooks/_common.sh"
run_local_hook pre-commit

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
[ -z "$staged" ] && exit 0

if command -v ruff > /dev/null 2>&1; then
    say "pre-commit: ruff"
    # shellcheck disable=SC2086
    ruff check $staged || {
        say "pre-commit: ruff failed. Fix, or commit with --no-verify."
        exit 1
    }
else
    say "pre-commit: ruff not installed, skipping lint (pip install -e '.[dev]')"
fi

# A merge commit is not code you just wrote, and "any test file the commit touches" means
# the whole merged range for one -- bringing `main` into a feature branch stages every test
# file that changed in between, which turned a three-second hook into a multi-minute one and
# straight into --no-verify. The lint above still runs: a botched conflict resolution is
# exactly the kind of thing it catches, and it costs a second even on a big merge.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
    say "pre-commit: merge commit -- linted, tests left to pre-push"
    exit 0
fi

CORE="tests/test_chunk_core.py tests/test_chunk_utils.py tests/test_callback_arity.py tests/test_new_chunks.py"

# TestAMDMaterialXCaching is intermittently flaky (~1 in 6) when test_new_chunks runs
# alongside other files -- it monkeypatches the network away, so it is shared process state,
# not a real download. A gate that blocks commits at random is a gate people switch off, so
# it is deselected here. It still runs on pre-push and in CI.
DESELECT="--deselect tests/test_new_chunks.py::TestAMDMaterialXCaching"

# Staged test files, so a test added or changed in this commit runs in it.
staged_tests=$(printf '%s\n' "$staged" | grep '^tests/test_.*\.py$' || true)

files=$(printf '%s\n%s\n' "$CORE" "$staged_tests" | tr ' ' '\n' | sed '/^$/d' | sort -u)
files=$(for f in $files; do [ -f "$f" ] && printf '%s ' "$f"; done)

say "pre-commit: pytest (core + staged tests)"
# -n0 on purpose: pytest.ini turns xdist on for the full suite, but spinning up workers
# costs ~6s, which is more than this whole set takes to run in one process (8.1s vs 2.4s
# measured). Parallelism is for the big run, not this one.
# shellcheck disable=SC2086
python -m pytest $files -q -n0 --no-header -p no:cacheprovider $DESELECT || {
    say "pre-commit: tests failed. Fix, or commit with --no-verify."
    exit 1
}
