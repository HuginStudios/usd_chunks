<?xml version="1.0"?>
<!-- A small three-joint desk arm for examples/scripts/urdf_to_isaac.py. Only URDF primitives
     (box, cylinder, sphere), so it needs no mesh files. Dimensions in metres, as URDF is. -->
<robot name="desk_arm">
  <material name="graphite"><color rgba="0.15 0.15 0.17 1"/></material>
  <material name="orange"><color rgba="0.95 0.45 0.08 1"/></material>
  <material name="steel"><color rgba="0.75 0.75 0.78 1"/></material>

  <link name="base">
    <visual><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.09" length="0.05"/></geometry><material name="graphite"/></visual>
    <collision><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.09" length="0.05"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.004" iyy="0.004" izz="0.008" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <link name="turntable">
    <visual><origin xyz="0 0 0.03"/><geometry><cylinder radius="0.06" length="0.06"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0 0 0.03"/><geometry><cylinder radius="0.06" length="0.06"/></geometry></collision>
    <inertial><mass value="0.6"/><inertia ixx="0.0007" iyy="0.0007" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <link name="upper_arm">
    <visual><origin xyz="0 0 0.12"/><geometry><box size="0.05 0.05 0.24"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0 0 0.12"/><geometry><box size="0.05 0.05 0.24"/></geometry></collision>
    <inertial><origin xyz="0 0 0.12"/><mass value="0.4"/><inertia ixx="0.002" iyy="0.002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <link name="forearm">
    <visual><origin xyz="0 0 0.1"/><geometry><box size="0.04 0.04 0.2"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0 0 0.1"/><geometry><box size="0.04 0.04 0.2"/></geometry></collision>
    <inertial><origin xyz="0 0 0.1"/><mass value="0.25"/><inertia ixx="0.0009" iyy="0.0009" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <link name="tool">
    <visual><geometry><sphere radius="0.03"/></geometry><material name="steel"/></visual>
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.00004" iyy="0.00004" izz="0.00004" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="base_yaw" type="revolute">
    <parent link="base"/><child link="turntable"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="2"/>
    <dynamics damping="0.5"/>
  </joint>

  <joint name="shoulder" type="revolute">
    <parent link="turntable"/><child link="upper_arm"/>
    <origin xyz="0 0 0.06"/><axis xyz="0 1 0"/>
    <limit lower="-1.6" upper="1.6" effort="10" velocity="2"/>
    <dynamics damping="0.5"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0 0 0.24"/><axis xyz="0 1 0"/>
    <limit lower="-2.4" upper="2.4" effort="6" velocity="2"/>
    <dynamics damping="0.3"/>
  </joint>

  <joint name="tool_mount" type="fixed">
    <parent link="forearm"/><child link="tool"/>
    <origin xyz="0 0 0.2"/>
  </joint>
</robot>
