#usda 1.0
(
    metersPerUnit = 0.01
    upAxis = "Z"
)

def Chunk "chunks"
{
    uniform token info:chunkType = "chunkgroup"
    string inputs:doc = """Creates a prim with a variant set ('test') that switches between two referenced assets.
The prim path is driven by the Prim chunk and shared across all chunks via expressions (@Prim.primpath_location@).
Variant A references asset_A.usd into {test=A}/geo, variant B references asset_B.usd into {test=B}/geo.
Expression syntax: @ChunkName.param_name@ — authors both a string value and a USD connection on the same attribute."""
    string inputs:variant_selection = "B"


    def Chunk "Prim" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        uniform token info:chunkType = "prim"
        uniform token outputs:chunk
        uniform float2 ui:nodegraph:node:pos = (-97.80822, 187.9452)
    }

    def Chunk "AddVariants" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        uniform token info:chunkType = "variant"
        token inputs:chunk.connect = </chunks/Prim.outputs:chunk>
        string inputs:primpath_location = "@Prim.primpath_location@"
        string inputs:primpath_location.connect = </chunks/Prim.inputs:primpath_location>
        string[] inputs:variant_entries:v_default = ["B"]
        string[] inputs:variant_entries:v_names = ["A,B,C"]
        string[] inputs:variant_entries:vs_name = ["test"]
        uniform token outputs:chunk
        uniform float2 ui:nodegraph:node:pos = (192.83955, 190.77254)
    }

    def Chunk "Reference" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        uniform token info:chunkType = "reference"
        token inputs:chunk.connect = </chunks/AddVariants.outputs:chunk>
        string inputs:file_path = "./assets/asset_A.usd"
        string inputs:primpath_location = "@Prim.primpath_location@{test=A}/geo"
        string inputs:primpath_location.connect = </chunks/Prim.inputs:primpath_location>
        uniform token outputs:chunk
        uniform float2 ui:nodegraph:node:pos = (518.22516, 21.298374)
    }

    def Chunk "Reference1" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        uniform token info:chunkType = "reference"
        token inputs:chunk.connect = </chunks/Reference.outputs:chunk>
        string inputs:file_path = "./assets/asset_B.usd"
        string inputs:primpath_location = "@Prim.primpath_location@{test=B}/geo"
        string inputs:primpath_location.connect = </chunks/Prim.inputs:primpath_location>
        uniform token outputs:chunk
        uniform float2 ui:nodegraph:node:pos = (839.17566, -22.543116)
    }

    def Chunk "SetVariant" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        uniform token info:chunkType = "set_variant"
        token inputs:chunk.connect = </chunks/AddVariants.outputs:chunk>
        string inputs:primpath_location = "@Prim.primpath_location@"
        string inputs:primpath_location.connect = </chunks/Prim.inputs:primpath_location>
        string inputs:variant_set = "test"
        string inputs:variant_selection = "B"
        string inputs:variant_selection.connect = </chunks.inputs:variant_selection>
        uniform token outputs:chunk
        uniform float2 ui:nodegraph:node:pos = (1160.0, -22.543116)
    }
}

