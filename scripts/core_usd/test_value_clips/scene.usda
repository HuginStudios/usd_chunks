#usda 1.0
(
    defaultPrim = "CubeGeo"
    metersPerUnit = 1
    upAxis = "Y"
)

def Mesh "CubeGeo" (
    doc = "A simple cube mesh. The Value Clips chunk will override its points attribute with animated data from clip files."
)
{
    # 8 vertices of a unit cube centered at origin
    point3f[] points = [
        (-0.5, -0.5, -0.5),
        ( 0.5, -0.5, -0.5),
        ( 0.5, -0.5,  0.5),
        (-0.5, -0.5,  0.5),
        (-0.5,  0.5, -0.5),
        ( 0.5,  0.5, -0.5),
        ( 0.5,  0.5,  0.5),
        (-0.5,  0.5,  0.5)
    ]

    int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
    int[] faceVertexIndices = [
        0, 1, 2, 3,
        4, 5, 6, 7,
        0, 1, 5, 4,
        1, 2, 6, 5,
        2, 3, 7, 6,
        3, 0, 4, 7
    ]

    uniform token subdivisionScheme = "none"
}
