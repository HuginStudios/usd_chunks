#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Y"
)

def Scope "chunks"
{
    def Chunk "BushyNature" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        uniform token info:chunkType = "chunkgroup"
        custom float inputs:Around_breakup = 0.6
        custom string inputs:Around_ground = ""
        custom float inputs:Around_reach = 1.6
        custom int inputs:Around_seed = 0
        string inputs:doc = """Bushes, ferns, nettles and grass crowding the object's base.
Thickest at the walls. Put the object on a ground and set Around_ground to it (or select the object, then the ground, before picking the style); without one the pile sits at the object's lowest point. Bring your own assets: Plants_files / Plants_prims: your own plants, a folder of USD files or prims in the scene; Plants_fit, the size they are fitted to (0 keeps theirs); Plants_spacing, how close they go, in sizes of the assets. Empty, the style uses its built-in kit (Poly Haven's, CC0, downloaded the first time).
Params: Around_reach, how far out the pile goes; Around_breakup, how patchy it is; Around_seed, another pattern."""
        custom string inputs:Plants_files = ""
        custom float inputs:Plants_fit = 0.8
        custom string inputs:Plants_prims = ""
        custom float inputs:Plants_spacing = 0.63
        uniform token outputs:chunk
        uniform float2 ui:nodegraph:node:pos = (0, 0)

        def Chunk "Around" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "around_field"
            float inputs:breakup = 0.6
            float inputs:breakup.connect = </chunks/BushyNature.inputs:Around_breakup>
            float inputs:breakup_size = 1
            string inputs:ground = ""
            string inputs:ground.connect = </chunks/BushyNature.inputs:Around_ground>
            string inputs:prim_path = "/"
            string inputs:primpath_location = "@Around.prim_path@/style_ground"
            string inputs:primpath_location.connect = </chunks/BushyNature/Around.inputs:prim_path>
            float inputs:reach = 1.6
            float inputs:reach.connect = </chunks/BushyNature.inputs:Around_reach>
            int inputs:seed = 0
            int inputs:seed.connect = </chunks/BushyNature.inputs:Around_seed>
            float inputs:softness = 0.8
            uniform token outputs:chunk
            rel ui:gizmo:reach:anchor = None
            uniform token ui:gizmo:reach:anchorSource = "primpath_location"
            uniform token ui:gizmo:reach:driver.connect = </chunks/BushyNature/Around.inputs:reach>
            uniform token[] ui:gizmo:reach:editmode = ["onPrimSelection"]
            uniform token ui:gizmo:reach:label = "Reach"
            uniform token ui:gizmo:reach:type = "cube"
            uniform float2 ui:nodegraph:node:pos = (0, 0)
        }

        def Chunk "Kit_shrub" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/BushyNature/Around.outputs:chunk>
            string inputs:model = "shrub_04"
            string inputs:primpath_location = "/style_kit/builtin/shrub"
            float inputs:scale = 1.5
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (260, 0)
        }

        def Chunk "Kit_fern" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/BushyNature/Kit_shrub.outputs:chunk>
            string inputs:model = "fern_02"
            string inputs:primpath_location = "/style_kit/builtin/fern"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (520, 0)
        }

        def Chunk "Kit_nettle" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/BushyNature/Kit_fern.outputs:chunk>
            string inputs:model = "nettle_plant"
            string inputs:primpath_location = "/style_kit/builtin/nettle"
            float inputs:scale = 1.6
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (780, 0)
        }

        def Chunk "Kit_weed" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/BushyNature/Kit_nettle.outputs:chunk>
            string inputs:model = "weed_plant_02"
            string inputs:primpath_location = "/style_kit/builtin/weed"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1040, 0)
        }

        def Chunk "Kit_grass" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/BushyNature/Kit_weed.outputs:chunk>
            string inputs:model = "grass_bermuda_01"
            string inputs:primpath_location = "/style_kit/builtin/grass"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1300, 0)
        }

        def Chunk "Plants" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "asset_kit"
            token inputs:chunk.connect = </chunks/BushyNature/Kit_grass.outputs:chunk>
            string inputs:fallback = "/style_kit/builtin/shrub/shrub_04* /style_kit/builtin/fern/fern_02* /style_kit/builtin/nettle/nettle_plant* /style_kit/builtin/weed/weed_plant_02* /style_kit/builtin/grass/grass_bermuda_01*"
            string inputs:files = ""
            string inputs:files.connect = </chunks/BushyNature.inputs:Plants_files>
            float inputs:fit = 0.8
            float inputs:fit.connect = </chunks/BushyNature.inputs:Plants_fit>
            string inputs:primpath_location = "/style_kit/plants"
            string inputs:prims = ""
            string inputs:prims.connect = </chunks/BushyNature.inputs:Plants_prims>
            float inputs:spacing = 0.63
            float inputs:spacing.connect = </chunks/BushyNature.inputs:Plants_spacing>
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1560, 0)
        }

        def Chunk "Scatter" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "scatter_points"
            token inputs:chunk.connect = </chunks/BushyNature/Plants.outputs:chunk>
            string inputs:density_primvar = "around"
            bool inputs:Distribution:auto_spacing = 0
            int inputs:Distribution:max_count = 6000
            string inputs:Distribution:sampling = "Tiles"
            int inputs:Distribution:seed = 7
            float inputs:Distribution:spacing (
                customData = {
                    dictionary chunk = {
                        string expression = "@Plants.out_spacing@"
                    }
                }
            )
            float inputs:Distribution:spacing.connect = </chunks/BushyNature/Plants.inputs:out_spacing>
            string inputs:inst_path = "@Around.prim_path@/style_plants"
            string inputs:inst_path.connect = </chunks/BushyNature/Around.inputs:prim_path>
            string[] inputs:prototypes:proto_path = ["/style_kit/plants/*"]
            float[] inputs:prototypes:proto_scale = [1]
            float[] inputs:prototypes:proto_weight = [100]
            string inputs:surface_prim = "/style_ground"
            string inputs:Variation:rand_axis = "Y"
            float inputs:Variation:scale_bias = 2.5
            float inputs:Variation:scale_max = 2
            float inputs:Variation:scale_min = 0.9
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1820, 0)
        }

        def Chunk "Output" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "output"
            token inputs:chunk.connect = </chunks/BushyNature/Scatter.outputs:chunk>
            uniform token ui:nodegraph:node:expansionState = "closed"
            uniform float2 ui:nodegraph:node:pos = (2100, 0)
        }
    }
}

