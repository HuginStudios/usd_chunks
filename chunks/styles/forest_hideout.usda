#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Y"
)

def Scope "chunks"
{
    def Chunk "ForestHideout" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        uniform token info:chunkType = "chunkgroup"
        custom float inputs:Around_breakup = 0.75
        custom string inputs:Around_ground = ""
        custom float inputs:Around_reach = 2.2
        custom int inputs:Around_seed = 0
        string inputs:doc = """Ferns, dry branches and mossy rocks around the object, like a forest floor.
Poly Haven ferns, branches, mossy rocks, dandelions and grass. Put the object on a ground and set Around_ground to it (or select the object, then the ground, before picking the style); without one the pile sits at the object's lowest point. The assets come from Poly Haven (CC0), downloaded the first time.
Params: Around_reach, how far out the pile goes; Around_breakup, how patchy it is; Around_seed, another pattern."""
        uniform token outputs:chunk
        uniform float2 ui:nodegraph:node:pos = (0, 0)

        def Chunk "Around" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "around_field"
            float inputs:breakup = 0.75
            float inputs:breakup.connect = </chunks/ForestHideout.inputs:Around_breakup>
            float inputs:breakup_size = 1
            string inputs:ground = ""
            string inputs:ground.connect = </chunks/ForestHideout.inputs:Around_ground>
            string inputs:prim_path = "/"
            string inputs:primpath_location = "@Around.prim_path@/style_ground"
            string inputs:primpath_location.connect = </chunks/ForestHideout/Around.inputs:prim_path>
            float inputs:reach = 2.2
            float inputs:reach.connect = </chunks/ForestHideout.inputs:Around_reach>
            int inputs:seed = 0
            int inputs:seed.connect = </chunks/ForestHideout.inputs:Around_seed>
            float inputs:softness = 0.8
            uniform token outputs:chunk
            rel ui:gizmo:reach:anchor = </style_ground>
            uniform token ui:gizmo:reach:anchorSource = "primpath_location"
            uniform token ui:gizmo:reach:driver.connect = </chunks/ForestHideout/Around.inputs:reach>
            uniform token[] ui:gizmo:reach:editmode = ["onPrimSelection"]
            uniform token ui:gizmo:reach:label = "Reach"
            uniform token ui:gizmo:reach:type = "cube"
            uniform float2 ui:nodegraph:node:pos = (0, 0)
        }

        def Chunk "Kit_fern" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/ForestHideout/Around.outputs:chunk>
            string inputs:model = "fern_02"
            string inputs:primpath_location = "/style_kit/fern"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (260, 0)
        }

        def Chunk "Kit_branches" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/ForestHideout/Kit_fern.outputs:chunk>
            string inputs:model = "dry_branches_medium_01"
            string inputs:primpath_location = "/style_kit/branches"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (520, 0)
        }

        def Chunk "Kit_mossy" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/ForestHideout/Kit_branches.outputs:chunk>
            string inputs:model = "rock_moss_set_01"
            string inputs:primpath_location = "/style_kit/mossy"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (780, 0)
        }

        def Chunk "Kit_dandelion" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/ForestHideout/Kit_mossy.outputs:chunk>
            string inputs:model = "dandelion_01"
            string inputs:primpath_location = "/style_kit/dandelion"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1040, 0)
        }

        def Chunk "Kit_grass" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/ForestHideout/Kit_dandelion.outputs:chunk>
            string inputs:model = "grass_bermuda_01"
            string inputs:primpath_location = "/style_kit/grass"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1300, 0)
        }

        def Chunk "Forest" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "scatter_points"
            token inputs:chunk.connect = </chunks/ForestHideout/Kit_grass.outputs:chunk>
            string inputs:density_primvar = "around"
            bool inputs:Distribution:auto_spacing = 0
            int inputs:Distribution:max_count = 6000
            string inputs:Distribution:sampling = "Tiles"
            int inputs:Distribution:seed = 3
            float inputs:Distribution:spacing = 0.1
            string inputs:inst_path = "@Around.prim_path@/style_forest"
            string inputs:inst_path.connect = </chunks/ForestHideout/Around.inputs:prim_path>
            string[] inputs:prototypes:proto_path = ["/style_kit/fern/fern_02*", "/style_kit/branches/dry_branches_medium_01*", "/style_kit/mossy/rock_moss_set_01*", "/style_kit/dandelion/dandelion_01*", "/style_kit/grass/grass_bermuda_01*"]
            float[] inputs:prototypes:proto_scale = [1.2, 1, 0.25, 1, 0.8]
            float[] inputs:prototypes:proto_weight = [40, 15, 12, 10, 23]
            string inputs:surface_prim = "/style_ground"
            string inputs:Variation:rand_axis = "Y"
            float inputs:Variation:scale_bias = 2.5
            float inputs:Variation:scale_max = 1.8
            float inputs:Variation:scale_min = 0.8
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1560, 0)
        }

        def Chunk "Output" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "output"
            token inputs:chunk.connect = </chunks/ForestHideout/Forest.outputs:chunk>
            uniform token ui:nodegraph:node:expansionState = "closed"
            uniform float2 ui:nodegraph:node:pos = (1840, 0)
        }
    }
}

