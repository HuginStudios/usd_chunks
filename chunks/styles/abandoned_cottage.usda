#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Y"
)

def Scope "chunks"
{
    def Chunk "AbandonedCottage" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        uniform token info:chunkType = "chunkgroup"
        custom float inputs:Around_breakup = 0.75
        custom string inputs:Around_ground = ""
        custom float inputs:Around_reach = 2.2
        custom int inputs:Around_seed = 0
        string inputs:doc = """A whole building gone to seed: ivy up the walls, bushes and rubble round its base.
Ivy climbs the walls in patches; bushes, ferns, nettles and grass crowd the walls; broken concrete, stones and planks lie between them. Put the building on a ground and set Around_ground to it (or select the building, then the ground, before picking the style). The assets come from Poly Haven (CC0), downloaded the first time.
Params: Around_reach, how far out the plants and rubble go; Around_breakup, how patchy; IvyPatches_threshold, how much of the walls the ivy may cover; Vines_growth, how far it has grown."""
        custom float inputs:IvyPatches_threshold = 0.42
        custom float inputs:Vines_growth = 100
        uniform token outputs:chunk
        uniform float2 ui:nodegraph:node:pos = (0, 0)

        def Chunk "IvyPatches" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "noise_field"
            string inputs:prim_path = "/"
            string inputs:primvar = "style_ivy"
            float inputs:size = 1.6
            float inputs:softness = 0.35
            float inputs:threshold = 0.42
            float inputs:threshold.connect = </chunks/AbandonedCottage.inputs:IvyPatches_threshold>
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (0, 0)
        }

        def Chunk "Vines" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "vine"
            token inputs:chunk.connect = </chunks/AbandonedCottage/IvyPatches.outputs:chunk>
            string inputs:density_primvar = "style_ivy"
            float inputs:grow_grp:climb = 0.6
            float inputs:grow_grp:density = 1
            float inputs:grow_grp:growth = 100
            float inputs:grow_grp:growth.connect = </chunks/AbandonedCottage.inputs:Vines_growth>
            int inputs:grow_grp:root_count = 60
            float inputs:hang_grp:hang = 12
            float inputs:hang_grp:hang_length = 15
            float inputs:leaf_grp:leaf_spacing = 0.9
            float inputs:shape_grp:thickness = 0.5
            string inputs:surface_prim = "/"
            string inputs:vine_path = "@IvyPatches.prim_path@/style_vines"
            string inputs:vine_path.connect = </chunks/AbandonedCottage/IvyPatches.inputs:prim_path>
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (260, 0)
        }

        def Chunk "Stems" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "curves_to_mesh"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Vines.outputs:chunk>
            string inputs:curves_prim = "@Vines.out_curves@"
            string inputs:curves_prim.connect = </chunks/AbandonedCottage/Vines.inputs:out_curves>
            string inputs:primpath_location = "/style_vines/stems"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (520, 0)
        }

        def Chunk "Bark" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "set_display_color"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Stems.outputs:chunk>
            float inputs:Color:color_b = 0.1
            float inputs:Color:color_g = 0.15
            float inputs:Color:color_r = 0.2
            string inputs:prim_path = "/style_vines/stems"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (780, 0)
        }

        def Chunk "Kit_leaf" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Bark.outputs:chunk>
            string inputs:model = "shrub_sorrel_01"
            string inputs:primpath_location = "/style_kit/leaf"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1040, 0)
        }

        def Chunk "Leaves" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "scatter_points"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Kit_leaf.outputs:chunk>
            string inputs:Distribution:sampling = "Tiles"
            string inputs:inst_path = "@IvyPatches.prim_path@/style_vines/leaves"
            string inputs:inst_path.connect = </chunks/AbandonedCottage/IvyPatches.inputs:prim_path>
            string inputs:points_prim = "@Vines.out_leaves@"
            string inputs:points_prim.connect = </chunks/AbandonedCottage/Vines.inputs:out_leaves>
            string[] inputs:prototypes:proto_path = ["/style_kit/leaf/shrub_sorrel_01*"]
            float[] inputs:prototypes:proto_scale = [1]
            float[] inputs:prototypes:proto_weight = [100]
            string inputs:Variation:align_up = "+Z"
            float inputs:Variation:rand_amount = 60
            string inputs:Variation:rand_axis = "Y"
            float inputs:Variation:scale_max = 0.5
            float inputs:Variation:scale_min = 0.25
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1300, 0)
        }

        def Chunk "Around" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "around_field"
            float inputs:breakup = 0.75
            float inputs:breakup.connect = </chunks/AbandonedCottage.inputs:Around_breakup>
            float inputs:breakup_size = 1
            token inputs:chunk.connect = </chunks/AbandonedCottage/Leaves.outputs:chunk>
            string inputs:ground = ""
            string inputs:ground.connect = </chunks/AbandonedCottage.inputs:Around_ground>
            string inputs:prim_path = "/"
            string inputs:primpath_location = "@Around.prim_path@/style_ground"
            string inputs:primpath_location.connect = </chunks/AbandonedCottage/Around.inputs:prim_path>
            float inputs:reach = 2.2
            float inputs:reach.connect = </chunks/AbandonedCottage.inputs:Around_reach>
            int inputs:seed = 0
            int inputs:seed.connect = </chunks/AbandonedCottage.inputs:Around_seed>
            float inputs:softness = 0.8
            uniform token outputs:chunk
            rel ui:gizmo:reach:anchor = </style_ground>
            uniform token ui:gizmo:reach:anchorSource = "primpath_location"
            uniform token ui:gizmo:reach:driver.connect = </chunks/AbandonedCottage/Around.inputs:reach>
            uniform token[] ui:gizmo:reach:editmode = ["onPrimSelection"]
            uniform token ui:gizmo:reach:label = "Reach"
            uniform token ui:gizmo:reach:type = "cube"
            uniform float2 ui:nodegraph:node:pos = (1560, 0)
        }

        def Chunk "Concrete" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_material"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Around.outputs:chunk>
            string inputs:material_path = "/materials/style_concrete"
            string inputs:texture = "concrete_debris"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1820, 0)
        }

        def Chunk "Block" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "mesh"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Concrete.outputs:chunk>
            float inputs:cube:depth = 0.26
            float inputs:cube:height = 0.18
            float inputs:cube:width = 0.3
            bool inputs:grid:grid_checker = 0
            string inputs:mesh_type = "cube"
            string inputs:prim_path = "@Around.prim_path@/style_kit/block"
            string inputs:prim_path.connect = </chunks/AbandonedCottage/Around.inputs:prim_path>
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (2080, 0)
        }

        def Chunk "Break" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "fracture"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Block.outputs:chunk>
            int inputs:generations = 3
            float inputs:jaggedness = 0.6
            string inputs:output_path = "@Around.prim_path@/style_kit/chunks"
            string inputs:output_path.connect = </chunks/AbandonedCottage/Around.inputs:prim_path>
            string inputs:source_prims = "/style_kit/block"
            float inputs:Surface:bevel = 0.3
            string inputs:Surface:inside_material = "/materials/style_concrete"
            string inputs:Surface:outside_material = "/materials/style_concrete"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (2340, 0)
        }

        def Chunk "HideBlock" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "property_editor"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Break.outputs:chunk>
            string inputs:edits_grp:edits = 'visibility = "invisible"'
            string inputs:prim = "@Around.prim_path@/style_kit/chunks"
            string inputs:prim.connect = </chunks/AbandonedCottage/Around.inputs:prim_path>
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (2600, 0)
        }

        def Chunk "Kit_stones" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/AbandonedCottage/HideBlock.outputs:chunk>
            string inputs:model = "namaqualand_stones_01"
            string inputs:primpath_location = "/style_kit/stones"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (2860, 0)
        }

        def Chunk "Plank" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "mesh"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Kit_stones.outputs:chunk>
            float inputs:cube:depth = 0.13
            float inputs:cube:height = 0.025
            float inputs:cube:width = 1.2
            bool inputs:grid:grid_checker = 0
            string inputs:mesh_type = "cube"
            string inputs:prim_path = "@Around.prim_path@/style_kit/plank"
            string inputs:prim_path.connect = </chunks/AbandonedCottage/Around.inputs:prim_path>
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (3120, 0)
        }

        def Chunk "PlankWood" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_material"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Plank.outputs:chunk>
            string inputs:material_path = "/materials/style_planks"
            string inputs:primpath_location = "/style_kit/plank"
            string inputs:texture = "brown_planks_05"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (3380, 0)
        }

        def Chunk "Debris" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "scatter_points"
            token inputs:chunk.connect = </chunks/AbandonedCottage/PlankWood.outputs:chunk>
            string inputs:density_primvar = "around"
            bool inputs:Distribution:auto_spacing = 0
            int inputs:Distribution:max_count = 6000
            string inputs:Distribution:sampling = "Tiles"
            float inputs:Distribution:spacing = 0.08
            string inputs:inst_path = "@Around.prim_path@/style_debris"
            string inputs:inst_path.connect = </chunks/AbandonedCottage/Around.inputs:prim_path>
            string[] inputs:prototypes:proto_path = ["/style_kit/chunks/Prototypes/*", "/style_kit/stones/namaqualand_stones_01*", "/style_kit/plank"]
            float[] inputs:prototypes:proto_scale = [1, 2, 1]
            float[] inputs:prototypes:proto_weight = [40, 30, 10]
            string inputs:surface_prim = "/style_ground"
            string inputs:Variation:rand_axis = "Y"
            float inputs:Variation:scale_bias = 2.5
            float inputs:Variation:scale_max = 1.6
            float inputs:Variation:scale_min = 0.4
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (3640, 0)
        }

        def Chunk "Kit_shrub" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Debris.outputs:chunk>
            string inputs:model = "shrub_04"
            string inputs:primpath_location = "/style_kit/shrub"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (3900, 0)
        }

        def Chunk "Kit_fern" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Kit_shrub.outputs:chunk>
            string inputs:model = "fern_02"
            string inputs:primpath_location = "/style_kit/fern"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (4160, 0)
        }

        def Chunk "Kit_nettle" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Kit_fern.outputs:chunk>
            string inputs:model = "nettle_plant"
            string inputs:primpath_location = "/style_kit/nettle"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (4420, 0)
        }

        def Chunk "Kit_weed" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Kit_nettle.outputs:chunk>
            string inputs:model = "weed_plant_02"
            string inputs:primpath_location = "/style_kit/weed"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (4680, 0)
        }

        def Chunk "Kit_grass" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Kit_weed.outputs:chunk>
            string inputs:model = "grass_bermuda_01"
            string inputs:primpath_location = "/style_kit/grass"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (4940, 0)
        }

        def Chunk "Plants" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "scatter_points"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Kit_grass.outputs:chunk>
            string inputs:density_primvar = "around"
            bool inputs:Distribution:auto_spacing = 0
            int inputs:Distribution:max_count = 6000
            string inputs:Distribution:sampling = "Tiles"
            int inputs:Distribution:seed = 7
            float inputs:Distribution:spacing = 0.09
            string inputs:inst_path = "@Around.prim_path@/style_plants"
            string inputs:inst_path.connect = </chunks/AbandonedCottage/Around.inputs:prim_path>
            string[] inputs:prototypes:proto_path = ["/style_kit/shrub/shrub_04*", "/style_kit/fern/fern_02*", "/style_kit/nettle/nettle_plant*", "/style_kit/weed/weed_plant_02*", "/style_kit/grass/grass_bermuda_01*"]
            float[] inputs:prototypes:proto_scale = [1.5, 1, 1.6, 1, 1]
            float[] inputs:prototypes:proto_weight = [25, 20, 25, 15, 25]
            string inputs:surface_prim = "/style_ground"
            string inputs:Variation:rand_axis = "Y"
            float inputs:Variation:scale_bias = 2.5
            float inputs:Variation:scale_max = 2
            float inputs:Variation:scale_min = 0.9
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (5200, 0)
        }

        def Chunk "Output" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "output"
            token inputs:chunk.connect = </chunks/AbandonedCottage/Plants.outputs:chunk>
            uniform token ui:nodegraph:node:expansionState = "closed"
            uniform float2 ui:nodegraph:node:pos = (5480, 0)
        }
    }
}

