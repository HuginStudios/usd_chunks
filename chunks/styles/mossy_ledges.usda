#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Y"
)

def Scope "chunks"
{
    def Chunk "MossyLedges" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        uniform token info:chunkType = "chunkgroup"
        string inputs:doc = """Grass and small plants taking hold on everything facing up: ledges, sills, wall tops.
A Facing Field finds the faces that look up, a Noise Field breaks them into patches, and plants are scattered there. Works on any mesh: the finer it is, the closer the patches follow it. Bring your own assets: Moss_files / Moss_prims: your own small plants or moss clumps, a folder of USD files or prims in the scene; Moss_fit, the size they are fitted to (0 keeps theirs); Moss_spacing, how close they go, in sizes of the assets. Empty, the style uses its built-in kit (Poly Haven's, CC0, downloaded the first time).
Params: Tops_angle, how far from level a face may tilt and still count; Patches_threshold, how much of it the plants cover; Scatter_seed, another pattern."""
        custom string inputs:Moss_files = ""
        custom float inputs:Moss_fit = 0.3
        custom string inputs:Moss_prims = ""
        custom float inputs:Moss_spacing = 1.27
        custom float inputs:Patches_threshold = 0.4
        custom int inputs:Scatter_seed = 4
        custom float inputs:Tops_angle = 25
        uniform token outputs:chunk
        uniform float2 ui:nodegraph:node:pos = (0, 0)

        def Chunk "Patches" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "noise_field"
            string inputs:prim_path = "/"
            string inputs:primvar = "style_patches"
            float inputs:size = 0.8
            float inputs:softness = 0.35
            float inputs:threshold = 0.4
            float inputs:threshold.connect = </chunks/MossyLedges.inputs:Patches_threshold>
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (0, 0)
        }

        def Chunk "Tops" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "facing_field"
            float inputs:angle = 25
            float inputs:angle.connect = </chunks/MossyLedges.inputs:Tops_angle>
            string inputs:base_primvar = "style_patches"
            token inputs:chunk.connect = </chunks/MossyLedges/Patches.outputs:chunk>
            string inputs:prim_path = "/"
            string inputs:primvar = "style_tops"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (260, 0)
        }

        def Chunk "Kit_grass" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/MossyLedges/Tops.outputs:chunk>
            string inputs:model = "grass_bermuda_01"
            string inputs:primpath_location = "/style_kit/builtin/grass"
            float inputs:scale = 1.4
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (520, 0)
        }

        def Chunk "Kit_sorrel" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/MossyLedges/Kit_grass.outputs:chunk>
            string inputs:model = "shrub_sorrel_01"
            string inputs:primpath_location = "/style_kit/builtin/sorrel"
            float inputs:scale = 2.5
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (780, 0)
        }

        def Chunk "Kit_weed" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "polyhaven_model"
            token inputs:chunk.connect = </chunks/MossyLedges/Kit_sorrel.outputs:chunk>
            string inputs:model = "weed_plant_02"
            string inputs:primpath_location = "/style_kit/builtin/weed"
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1040, 0)
        }

        def Chunk "Moss" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "asset_kit"
            token inputs:chunk.connect = </chunks/MossyLedges/Kit_weed.outputs:chunk>
            string inputs:fallback = "/style_kit/builtin/grass/grass_bermuda_01* /style_kit/builtin/sorrel/shrub_sorrel_01* /style_kit/builtin/weed/weed_plant_02*"
            string inputs:files = ""
            string inputs:files.connect = </chunks/MossyLedges.inputs:Moss_files>
            float inputs:fit = 0.3
            float inputs:fit.connect = </chunks/MossyLedges.inputs:Moss_fit>
            string inputs:primpath_location = "/style_kit/moss"
            string inputs:prims = ""
            string inputs:prims.connect = </chunks/MossyLedges.inputs:Moss_prims>
            float inputs:spacing = 1.27
            float inputs:spacing.connect = </chunks/MossyLedges.inputs:Moss_spacing>
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1300, 0)
        }

        def Chunk "Scatter" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "scatter_points"
            token inputs:chunk.connect = </chunks/MossyLedges/Moss.outputs:chunk>
            string inputs:density_primvar = "style_tops"
            bool inputs:Distribution:auto_spacing = 0
            int inputs:Distribution:max_count = 8000
            string inputs:Distribution:sampling = "Tiles"
            int inputs:Distribution:seed = 4
            int inputs:Distribution:seed.connect = </chunks/MossyLedges.inputs:Scatter_seed>
            float inputs:Distribution:spacing (
                customData = {
                    dictionary chunk = {
                        string expression = "@Moss.out_spacing@"
                    }
                }
            )
            float inputs:Distribution:spacing.connect = </chunks/MossyLedges/Moss.inputs:out_spacing>
            string inputs:inst_path = "@Patches.prim_path@/style_moss"
            string inputs:inst_path.connect = </chunks/MossyLedges/Patches.inputs:prim_path>
            string[] inputs:prototypes:proto_path = ["/style_kit/moss/*"]
            float[] inputs:prototypes:proto_scale = [1]
            float[] inputs:prototypes:proto_weight = [100]
            string inputs:surface_prim = "/"
            string inputs:Variation:rand_axis = "Y"
            float inputs:Variation:scale_bias = 2
            float inputs:Variation:scale_min = 0.4
            uniform token outputs:chunk
            uniform float2 ui:nodegraph:node:pos = (1560, 0)
        }

        def Chunk "Output" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:chunkType = "output"
            token inputs:chunk.connect = </chunks/MossyLedges/Scatter.outputs:chunk>
            uniform token ui:nodegraph:node:expansionState = "closed"
            uniform float2 ui:nodegraph:node:pos = (1840, 0)
        }
    }
}

